#!/system/bin/sh
set -eu
MODE=$1
APK=$2
RESTART_TAOBAO=$3
TARGET=$(cmd package path com.kapinote.ai)
TARGET=${TARGET#package:}
case "$TARGET" in /data/app/*/com.kapinote.ai-*/base.apk) ;; *) echo '未找到匹配的咔皮安装' >&2; exit 1 ;; esac
CURRENT=$(sha256sum "$TARGET")
CURRENT=${CURRENT%% *}
case "$CURRENT" in @STOCK_HASH@|@PATCH_HASH@) ;; *) echo '咔皮版本已变化，未改动当前安装' >&2; exit 1 ;; esac
if [ "$MODE" = apply ]; then
    ACTUAL=$(sha256sum "$APK")
    ACTUAL=${ACTUAL%% *}
    [ "$ACTUAL" = '@PATCH_HASH@' ] || { echo '适配文件校验失败' >&2; exit 1; }
elif [ "$MODE" != restore ]; then
    echo '未知操作' >&2; exit 1
fi
while awk -v target="$TARGET" '$5 == target { found=1 } END { exit !found }' /proc/self/mountinfo; do
    umount -l "$TARGET"
done
ORIGINAL=$(sha256sum "$TARGET")
ORIGINAL=${ORIGINAL%% *}
[ "$ORIGINAL" = '@STOCK_HASH@' ] || { echo '原版咔皮校验不匹配' >&2; exit 1; }
if [ "$MODE" = apply ]; then
    chown 1000:1000 "$APK"
    chmod 0644 "$APK"
    chcon u:object_r:apk_data_file:s0 "$APK"
    mount --bind "$APK" "$TARGET"
fi
# Killing the process preserves Android's enabled accessibility-service setting.
for APP_PID in $(pidof com.kapinote.ai); do kill -9 "$APP_PID"; done
if [ "$RESTART_TAOBAO" = 1 ]; then
    for APP_PID in $(pidof com.taobao.taobao); do kill -9 "$APP_PID"; done
fi
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
echo "$MODE|$BOOT_ID"
